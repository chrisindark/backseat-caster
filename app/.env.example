# BackseatCaster Environment Configuration
SERVICE_NAME=backseat-caster

# Database
DATABASE_URL=sqlite:///./data/backseatcaster.db

# Storage
DOWNLOADS_DIR=./data/downloads
# Optional hero/ability templates for Phase 3 identification:
# <HERO_TEMPLATES_DIR>/<game>/heroes/*.png and /abilities/*.png
HERO_TEMPLATES_DIR=./data/hero_templates

# YouTube Channel (can be @handle, channel ID, or channel URL)
# Example: @chrisindark or https://www.youtube.com/@chrisindark/videos
DEFAULT_YOUTUBE_CHANNEL=@chrisindark

# Celery Worker Configuration
# If local Redis is running: redis://localhost:6379/0
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TTL=3600

# Celery will fall back to in-memory/direct execution if Redis is not connected
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Phase 8: autonomous auto-stage & scheduling pipeline
AUTO_STAGE_ENABLED=False
AUTO_STAGE_TOP_N=3
AUTO_STAGE_MIN_SCORE=0.6
AUTO_STAGE_CLIPPING_MODE=third_person
AUTO_STAGE_FIRST_SLOT_HOURS=1
AUTO_STAGE_INTERVAL_HOURS=24

# Phase 8: Gemini metadata generation (deterministic fallback when unset)
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_METADATA_ENABLED=True

# YouTube Data API quota accounting (uploads cost 1,600 of the 10,000 daily units)
YOUTUBE_DAILY_QUOTA_UNITS=10000
YOUTUBE_UPLOAD_QUOTA_COST=1600
YOUTUBE_QUOTA_TIMEZONE=America/Los_Angeles

# Server
HOST=127.0.0.1
PORT=3001
DEBUG=True
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
