# ==============================================================================
# BackseatCaster Environment Configuration (.env.example)
#
# Copy this file to .env and configure your local or container environment:
#   cp .env.example .env
# ==============================================================================

SERVICE_NAME=backseat-caster

# ------------------------------------------------------------------------------
# Server & Network Configuration
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=3001
DEBUG=True
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# Database (SQLite)
# ------------------------------------------------------------------------------
# Default local SQLite database file:
DATABASE_URL=sqlite:///./data/backseatcaster.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# Storage Paths
# ------------------------------------------------------------------------------
DOWNLOADS_DIR=./data/downloads
RENDERS_DIR=./data/renders
HIGHLIGHTS_DIR=./data/highlights
HERO_TEMPLATES_DIR=./data/hero_templates

# ------------------------------------------------------------------------------
# Default YouTube Channel
# ------------------------------------------------------------------------------
# Optional default channel handle or URL (e.g. @YourChannel or https://www.youtube.com/@YourChannel/videos)
DEFAULT_YOUTUBE_CHANNEL=

# ------------------------------------------------------------------------------
# Background Processing & Celery Worker
# ------------------------------------------------------------------------------
# When Redis is available, tasks execute asynchronously via Celery.
# If Redis is unavailable, BackseatCaster automatically degrades to FastAPI BackgroundTasks.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TTL=3600
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ------------------------------------------------------------------------------
# Preflight & System Health
# ------------------------------------------------------------------------------
# Minimum free disk space in GB required for VOD downloads and renders
PREFLIGHT_MIN_DISK_SPACE_GB=2.0

# ------------------------------------------------------------------------------
# Autonomous Staging & Scheduling Pipeline (Phase 8)
# ------------------------------------------------------------------------------
AUTO_STAGE_ENABLED=False
AUTO_STAGE_TOP_N=3
AUTO_STAGE_MIN_SCORE=0.6
AUTO_STAGE_CLIPPING_MODE=third_person
AUTO_STAGE_FIRST_SLOT_HOURS=0
AUTO_STAGE_INTERVAL_HOURS=4
AUTO_STAGE_TIMEZONE=Asia/Kolkata
AUTO_STAGE_DAILY_SLOTS=["08:00", "12:30", "16:00", "18:30", "20:30", "23:00"]

# Maintenance pipeline: purge uploaded render files + sweep-stage top highlights
AUTO_CLEANUP_UPLOADED_RENDERS=True
AUTO_CLEANUP_VOD=False
# Interval in minutes between Celery beat sweeps (0 disables periodic runs)
AUTO_PIPELINE_INTERVAL_MINUTES=0

# ------------------------------------------------------------------------------
# AI Copy & LLM Metadata Generation (Universal OpenAI-compatible API)
# ------------------------------------------------------------------------------
# Disabled by default. When false or unconfigured, BackseatCaster uses deterministic
# rule-based copy without LLM calls.
LLM_METADATA_ENABLED=False

# Universal OpenAI-compatible endpoint (works with Ollama, LM Studio, Groq, OpenAI, Gemini, etc.)
# For local Ollama: http://localhost:11434/v1 (model: llama3.2, mistral, etc.)
# For OpenAI: https://api.openai.com/v1 (model: gpt-4o-mini, etc.)
# For Groq: https://api.groq.com/openai/v1 (model: llama-3.3-70b-versatile, etc.)
# For Gemini: https://generativelanguage.googleapis.com/v1beta/openai (model: gemini-2.5-flash)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.2

# (Optional legacy variables - automatically recognized if set)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# YouTube Data API & OAuth Configuration
# ------------------------------------------------------------------------------
YOUTUBE_CLIENT_SECRETS_FILE=./data/client_secrets.json
YOUTUBE_TOKEN_FILE=./data/youtube_token.json
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/v1/youtube/auth/callback

# Advisory daily quota accounting (YouTube upload costs 1,600 of 10,000 daily units)
YOUTUBE_DAILY_QUOTA_UNITS=10000
YOUTUBE_UPLOAD_QUOTA_COST=1600
YOUTUBE_QUOTA_TIMEZONE=America/Los_Angeles
